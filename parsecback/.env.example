# Режим
NODE_ENV=development
PORT=7101
PUBLIC_URL=http://api.parsec.toolzar.localhost:7101
FRONTEND_URL=http://parsec.toolzar.localhost:3020


GLOBAL_MAX_IN_FLIGHT=200
YANDEX_LIVE_REQUEST_LIMIT=20
GOOGLE_LIVE_REQUEST_LIMIT=20
YANDEX_XML_REQUEST_LIMIT=50
DEFAULT_REQUEST_LIMIT=32

# База/Redis
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=parsec
DB_PASS=YOUR_PASSWORD
DB_NAME=parseback
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_me

# Сессии/куки
SESSION_SECRET=change_me_strong_secret
COOKIE_NAME=psk.sid
COOKIE_DOMAIN=.toolzar.localhost        # для локал/стейджа на hosts.
COOKIE_SECURE=false                     # локально без HTTPS -> false; на реальном стейдже/проде -> true
COOKIE_SAMESITE=Lax                     # Lax — безопасно и достаточно для сабдоменов
API_KEY_ENC_SECRET=YOUR_SECRET

# CORS (через запятую)
CORS_ORIGINS=http://parsec.toolzar.localhost,http://api.parsec.toolzar.localhost,http://localhost,http://127.0.0.1,http://api.parsec.toolzar.localhost:7101
CORS_CREDENTIALS=true


# parsers
# RANKSCAN_BASE_URL=http://45.87.246.109:3003
RANKSCAN_BASE_URL=http://localhost:3005


# payment stage 4300 0000 0000 0777
TINKOFF_BASE_URL=https://rest-api-test.tinkoff.ru/v2
TINKOFF_TERMINAL_KEY=SEMEN_KEY
TINKOFF_TERMINAL_SECRET=SEMEN_SECRET

TELEGRAM_BOT_TOKEN=SEMEN_KEY
TELEGRAM_CHAT_ID=-SEMEN_SECRET

# keyturbo
KEYTURBO_TOKEN=SEMEN_KEY
KEYTURBO_FREQUENCY_API_URL=https://api.key-turbo.ru/frequency-api


# DigitalKassa
DIGITALKASSA_ACTOR_TOKEN=SEMEN_KEY
DIGITALKASSA_BASE_URL=https://api.digitalkassa.ru/v2.1
DIGITALKASSA_ACTOR_ID=SEMEN_KEY
DIGITALKASSA_CGROUP_ID=5081
DIGITALKASSA_TIMEZONE=3
DIGITALKASSA_IS_INTERNET=1
# тип налогообложения 32 - ПСН (патентная система налогообложения)
DIGITALKASSA_TAXATION=32
# Отключить фоновые задачи и оповещения, сохранив авторизацию и SMTP сброса пароля
STUB_MODE=false
# При true также игнорировать платёжные webhook и отклонять создание частот до списания.
TYPEORM_SYNC=false
JWT_SECRET=replace_with_strong_random_secret
RESET_PASSWORD_SECRET=replace_with_another_strong_secret
SUPPORT_EMAIL_HOST=smtp.example.com
SUPPORT_EMAIL_USER=parsec@example.com
SUPPORT_EMAIL_PASSWORD=replace_me
SUPPORT_EMAIL=parsec@example.com
ALERT_EMAIL=alerts@example.com
CRITICAL_EMAIL=alerts@example.com
