{
  "name": "parsecback",
  "version": "0.0.4",
  "description": "Parsing api",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "test": "jest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch -r tsconfig-paths/register",
    "start:dev2": "nest start --watch",
    "start:debug": "nest start --debug --watch -r tsconfig-paths/register",
    "start:debug2": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0 && npm run typecheck",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.5",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.18",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "got": "^11.8.6",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "keyv": "^5.5.5",
    "nodemailer": "^10.5.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.18",
    "@types/cookie-parser": "^1.4.9",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.17.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "ajv": "^8.18.0",
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "eslint": {
      "ajv": "^6.14.0"
    },
    "picomatch": "^4.0.4",
    "lodash": "4.18.1",
    "handlebars": "^4.7.10",
    "path-to-regexp": "8.4.2",
    "fast-uri": "^3.1.9",
    "js-yaml@^4.0.0": "^4.3.2",
    "qs": "^6.16.1",
    "tmp": "^0.2.7",
    "uuid": "11.1.1",
    "minimatch@^3.0.0": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@^5.0.0": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@^9.0.0": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@^10.0.0": {
      "brace-expansion": "^5.0.12"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
