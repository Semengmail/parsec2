NODE_ENV=production
# Локально 127.0.0.1; production: проверить шлюз klaster-key_default (172.18.0.1).
BIND_ADDR=127.0.0.1
STUB_MODE=true
NEXT_PUBLIC_STUB_MODE=true
PUBLIC_URL=https://api.parsec.toolzar.ru
FRONTEND_URL=https://parsec.toolzar.ru
CORS_ORIGINS=https://parsec.toolzar.ru
CORS_CREDENTIALS=true
HTTP_ACCESS_LOG_ENABLED=false

# Для первого восстановления временно timescale/timescaledb:2.18.0-pg17.
TIMESCALE_IMAGE=timescale/timescaledb:2.31.0-pg17
# Уточнить бюджет на общем сервере ДО первого запуска; tune пишет настройки в том.
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.0
TS_TUNE_MEMORY=512MB
TS_TUNE_NUM_CPUS=1
TS_TUNE_MAX_CONNS=60
DB_BIND=0.0.0.0
DB_PORT=5433
DB_HOST=db
DB_NAME=parseback
DB_USER=parsec
DB_PASS=replace_with_strong_password
# true: TypeORM при старте приводит схему к entities (решение Nick от 12.11.2026).
TYPEORM_SYNC=true
DB_LOGGING=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_password

SESSION_SECRET=replace_with_strong_random_secret
JWT_SECRET=replace_with_strong_random_secret
RESET_PASSWORD_SECRET=replace_with_different_random_secret
API_KEY_ENC_SECRET=replace_with_original_encryption_secret
COOKIE_NAME=psk.sid
COOKIE_DOMAIN=.toolzar.ru
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# NEXT_PUBLIC_* встраиваются при build; после изменений пересобрать клиент.
NEXT_PUBLIC_API_URL=https://api.parsec.toolzar.ru
NEXT_PUBLIC_API_BASE=https://api.parsec.toolzar.ru
NEXT_PUBLIC_BASE_URL=https://parsec.toolzar.ru
NEXT_PUBLIC_MAIN_PAGE_URL=https://parsec.toolzar.ru
NEXT_PUBLIC_COOKIE_NAME=psk.sid
# Главная parsec.toolzar.ru → 301 на лендинг (строка запроса сохраняется).
# Встраивается при build; пусто — редиректа нет. Production: https://toolzar.ru/parsec
PARSEC_LANDING_URL=

SUPPORT_EMAIL_HOST=replace_with_smtp_host
SUPPORT_EMAIL_USER=parsec@toolzar.ru
SUPPORT_EMAIL_PASSWORD=replace_with_smtp_password
SUPPORT_EMAIL=parsec@toolzar.ru
ALERT_EMAIL=
CRITICAL_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RANKSCAN_BASE_URL=http://127.0.0.1:3005
KEYTURBO_TOKEN=
KEYTURBO_FREQUENCY_API_URL=https://api.key-turbo.ru/frequency-api
TINKOFF_BASE_URL=https://securepay.tinkoff.ru/v2
TINKOFF_TERMINAL_KEY=
TINKOFF_TERMINAL_SECRET=
DIGITALKASSA_ACTOR_TOKEN=
DIGITALKASSA_BASE_URL=https://api.digitalkassa.ru/v2.1
DIGITALKASSA_ACTOR_ID=
DIGITALKASSA_CGROUP_ID=
DIGITALKASSA_TIMEZONE=3
DIGITALKASSA_IS_INTERNET=1
DIGITALKASSA_TAXATION=32
GLOBAL_MAX_IN_FLIGHT=200
YANDEX_LIVE_REQUEST_LIMIT=20
GOOGLE_LIVE_REQUEST_LIMIT=20
YANDEX_XML_REQUEST_LIMIT=50
DEFAULT_REQUEST_LIMIT=32
